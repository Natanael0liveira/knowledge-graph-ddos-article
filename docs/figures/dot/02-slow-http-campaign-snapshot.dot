// Diagrama 2 — Snapshot do grafo durante campanha distribuída de Slow HTTP DoS.
// Sessões alinhadas em colunas (rank=same), 40 sessões coordenadas espalhadas
// em 40 ASNs e 32 prefixos /24 distintos. O discriminador do cluster vem de
// sinais de peso alto (JA4 + padrão temporal), não de proximidade de rede.

digraph SlowHTTPCampaignSnapshot {
    rankdir=TB;
    bgcolor="white";
    fontname="Helvetica";
    nodesep=0.45;
    ranksep=1.1;
    newrank=true;
    labelloc="t";
    label=<<B>Snapshot do grafo em t = 180 s</B><BR/><FONT POINT-SIZE="10" COLOR="#4A4A4A">540 sessões totais (500 legítimas + 40 coordenadas Slow HTTP DoS distribuído); 3 amostras de cada lado<BR/>Endereços IP conforme RFC 5737; ASNs conforme RFC 5398 (64496–64511 e 64500–64511 reservados para documentação)</FONT>>;

    node [fontname="Helvetica", fontsize=10, fontcolor="#1A1A1A"];
    edge [fontname="Helvetica", fontsize=9, color="#6B6B6B", fontcolor="#4A4A4A"];

    // ============================================================
    // Cluster LEGÍTIMO (à esquerda)
    // ============================================================
    subgraph cluster_legit {
        label=<<B>500 sessões legítimas</B>  (3 amostras)>;
        labelloc="t";
        labeljust="l";
        fontsize=10;
        fontcolor="#4A4A4A";
        style="filled,rounded";
        fillcolor="#F5F5F5";
        color="#6B6B6B";
        penwidth=1;
        margin=15;

        // Linha 1 — sessões legítimas (alinhadas)
        s_user_1 [
            label=<<B>s_user_001</B><BR/><FONT POINT-SIZE="8" COLOR="#4A4A4A">Chrome 124<BR/>AS 64496  ·  UserBehavior</FONT>>,
            shape=ellipse, style=filled, fillcolor="white", color="#6B6B6B",
            width=1.6, height=0.8
        ];
        s_user_2 [
            label=<<B>s_user_017</B><BR/><FONT POINT-SIZE="8" COLOR="#4A4A4A">Safari 17<BR/>AS 64497  ·  UserBehavior</FONT>>,
            shape=ellipse, style=filled, fillcolor="white", color="#6B6B6B",
            width=1.6, height=0.8
        ];
        s_user_3 [
            label=<<B>s_user_042</B><BR/><FONT POINT-SIZE="8" COLOR="#4A4A4A">Firefox 122<BR/>AS 64498  ·  UserBehavior</FONT>>,
            shape=ellipse, style=filled, fillcolor="white", color="#6B6B6B",
            width=1.6, height=0.8
        ];

        // Linha 2 — identidades (alinhadas)
        id_user_1 [
            label=<<B>Identity</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#4A4A4A">ja4 = t13d_a1b2...<BR ALIGN="LEFT"/>ip ∈ 192.0.2.0/24</FONT>>,
            shape=box, style=filled, fillcolor="white", color="#888888", fontsize=9
        ];
        id_user_2 [
            label=<<B>Identity</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#4A4A4A">ja4 = q13d_c3d4...<BR ALIGN="LEFT"/>ip ∈ 198.51.100.0/24</FONT>>,
            shape=box, style=filled, fillcolor="white", color="#888888", fontsize=9
        ];
        id_user_3 [
            label=<<B>Identity</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#4A4A4A">ja4 = t13d_e5f6...<BR ALIGN="LEFT"/>ip ∈ 203.0.113.0/24</FONT>>,
            shape=box, style=filled, fillcolor="white", color="#888888", fontsize=9
        ];

        // Forçar alinhamento em linhas
        { rank=same; s_user_1; s_user_2; s_user_3; }
        { rank=same; id_user_1; id_user_2; id_user_3; }

        s_user_1 -> id_user_1 [label="hasIdentity", fontsize=8];
        s_user_2 -> id_user_2 [label="hasIdentity", fontsize=8];
        s_user_3 -> id_user_3 [label="hasIdentity", fontsize=8];
    }

    // ============================================================
    // Cluster ATACANTE (à direita)
    // ============================================================
    subgraph cluster_attack {
        label=<<B>40 sessões coordenadas</B>  (3 amostras) — ataques distribuídos de Slow HTTP DoS<BR/><FONT POINT-SIZE="9" COLOR="#4A4A4A">espalhadas em 40 ASNs distintos e 32 prefixos /24 diferentes</FONT>>;
        labelloc="t";
        labeljust="l";
        fontsize=10;
        fontcolor="#7A3A3A";
        style="filled,rounded";
        fillcolor="#F5EDED";
        color="#7A3A3A";
        penwidth=1;
        margin=15;

        // Linha 1 — sessões atacantes (alinhadas)
        s_a1 [
            label=<<B>s_a1</B><BR/><FONT POINT-SIZE="8" COLOR="#4A4A4A">ip ∈ 192.0.2.0/24  ·  AS 64500<BR/>BotBehavior  ·  5 conn</FONT>>,
            shape=ellipse, style=filled, fillcolor="white", color="#7A3A3A",
            width=1.6, height=0.8
        ];
        s_a2 [
            label=<<B>s_a2</B><BR/><FONT POINT-SIZE="8" COLOR="#4A4A4A">ip ∈ 198.51.100.0/24  ·  AS 64501<BR/>BotBehavior  ·  4 conn</FONT>>,
            shape=ellipse, style=filled, fillcolor="white", color="#7A3A3A",
            width=1.6, height=0.8
        ];
        s_a3 [
            label=<<B>s_a3</B><BR/><FONT POINT-SIZE="8" COLOR="#4A4A4A">ip ∈ 203.0.113.0/24  ·  AS 64502<BR/>BotBehavior  ·  5 conn</FONT>>,
            shape=ellipse, style=filled, fillcolor="white", color="#7A3A3A",
            width=1.6, height=0.8
        ];

        { rank=same; s_a1; s_a2; s_a3; }

        // Sub-relações relatedBy de peso alto entre as três
        s_a1 -> s_a2 [
            label=<<FONT POINT-SIZE="8">relatedByTLSFingerprint<BR/>relatedByTemporalPattern</FONT>>,
            style=dashed, dir=both, color="#1F3A5F", penwidth=1.2, fontcolor="#1F3A5F"
        ];
        s_a2 -> s_a3 [
            label=<<FONT POINT-SIZE="8">relatedByTLSFingerprint<BR/>relatedByTemporalPattern</FONT>>,
            style=dashed, dir=both, color="#1F3A5F", penwidth=1.2, fontcolor="#1F3A5F"
        ];
        s_a1 -> s_a3 [
            label=<<FONT POINT-SIZE="8">relatedByTLSFingerprint</FONT>>,
            style=dashed, dir=both, color="#1F3A5F", penwidth=1.2, fontcolor="#1F3A5F",
            constraint=false
        ];
    }

    // ============================================================
    // Linha inferior (alinhada): Endpoint + Discriminador (azul escuro)
    // ============================================================
    endpoint [
        label=<<B>Endpoint</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#DDE5EE">────────────<BR ALIGN="LEFT"/>/api/checkout/payment<BR ALIGN="LEFT"/>APIEndpoint<BR ALIGN="LEFT"/>(processamento custoso)</FONT>>,
        shape=box,
        style="filled,rounded,bold",
        fillcolor="#1F3A5F",
        fontcolor="white",
        color="#1F3A5F",
        penwidth=1.5
    ];

    discriminator [
        label=<<B>Discriminador do cluster</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#DDE5EE">────────────────────<BR ALIGN="LEFT"/>tls_ja4 = t13d1516h2_8daaf6...<BR ALIGN="LEFT"/>temporal: 1 byte / 15 s<BR ALIGN="LEFT"/>conn_duration ≈ 165 s<BR ALIGN="LEFT"/>byte_rate = 0.067 B/s<BR ALIGN="LEFT"/>method = POST<BR ALIGN="LEFT"/>────────────────────<BR ALIGN="LEFT"/>ASN: 40 distintos — não discriminador<BR ALIGN="LEFT"/>ip_prefix: 32 /24 — não discriminador</FONT>>,
        shape=box,
        style="filled,rounded,bold",
        fillcolor="#1F3A5F",
        fontcolor="white",
        color="#1F3A5F",
        penwidth=1.5
    ];

    { rank=same; endpoint; discriminator; }

    // targets — legítimos e atacantes para endpoint
    s_user_1 -> endpoint [label="targets", fontsize=8];
    s_user_2 -> endpoint [label="targets", fontsize=8];
    s_user_3 -> endpoint [label="targets", fontsize=8];
    s_a1 -> endpoint [label="targets", fontsize=8, color="#1F3A5F"];
    s_a2 -> endpoint [label="targets", fontsize=8, color="#1F3A5F"];
    s_a3 -> endpoint [label="targets", fontsize=8, color="#1F3A5F"];

    // shares — somente atacantes para o discriminador
    s_a1 -> discriminator [label=<<FONT POINT-SIZE="8">shares</FONT>>, color="#1F3A5F"];
    s_a2 -> discriminator [label=<<FONT POINT-SIZE="8">shares</FONT>>, color="#1F3A5F"];
    s_a3 -> discriminator [label=<<FONT POINT-SIZE="8">shares</FONT>>, color="#1F3A5F"];
}
