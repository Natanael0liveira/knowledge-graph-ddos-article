// Diagrama 3 — Regra CoordinatedHTTPFlood dispara sobre soma ponderada
// das sub-relações relatedBy_*, emite veredito, gera cadeia de evidência
// e liga à política de mitigação com escopo derivado.
//
// Paleta refinada: cinzas + azul escuro pontual.

digraph RuleFiresEvidenceChain {
    rankdir=TB;
    bgcolor="white";
    fontname="Helvetica";
    nodesep=0.6;
    ranksep=0.9;
    labelloc="t";
    label=<<B>Regra CoordinatedHTTPFlood — disparo por soma ponderada das sub-relações relatedBy</B>>;

    node [fontname="Helvetica", fontsize=10, fontcolor="#1A1A1A"];
    edge [fontname="Helvetica", fontsize=10, color="#6B6B6B", fontcolor="#4A4A4A"];

    // ----- Pré-condições -----
    cluster_node [
        label=<<B>Cluster relatedTo</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#4A4A4A">40 sessões com soma ponderada de:<BR ALIGN="LEFT"/>• relatedByTLSFingerprint (alto)<BR ALIGN="LEFT"/>• relatedByTemporalPattern (alto)<BR ALIGN="LEFT"/>• relatedByEndpointConvergence (médio)<BR ALIGN="LEFT"/>Σ peso ≥ τ_cluster</FONT>>,
        shape=box,
        style="filled,rounded",
        fillcolor="#F5F5F5",
        color="#6B6B6B",
        penwidth=1
    ];

    endpoint [
        label=<<B>Endpoint</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#4A4A4A">/api/checkout/payment</FONT>>,
        shape=box,
        style="filled,rounded",
        fillcolor="#F5F5F5",
        color="#6B6B6B",
        penwidth=1
    ];

    // ----- A regra (azul escuro) -----
    rule [
        label=<<B>Regra: CoordinatedHTTPFlood</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#DDE5EE">────────────────────<BR ALIGN="LEFT"/>|S| ≥ k_min   (40 ≥ 10)<BR ALIGN="LEFT"/>todas com targets ao mesmo Endpoint<BR ALIGN="LEFT"/>Σ peso(relatedBy_i) ≥ τ_cluster<BR ALIGN="LEFT"/>conn_agg = 200 &gt; τ_rate<BR ALIGN="LEFT"/>behavior(s) compatível com BotBehavior</FONT>>,
        shape=hexagon,
        style="filled",
        fillcolor="#1F3A5F",
        fontcolor="white",
        color="#1F3A5F",
        penwidth=1.5
    ];

    // ----- Veredito (azul escuro destacado) -----
    verdict [
        label=<<B>CoordinatedHTTPFlood</B><BR/><FONT POINT-SIZE="9" COLOR="#DDE5EE">subclasse de SlowHTTPDDoSFamily<BR/>confidence: high<BR/>40 sessões, 200 conexões presas</FONT>>,
        shape=box,
        style="filled,rounded,bold",
        fillcolor="#1F3A5F",
        fontcolor="white",
        color="#1F3A5F",
        penwidth=2
    ];

    // ----- Cadeia de evidência (cinza claro) -----
    evidence [
        label=<<B>Cadeia de evidência</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#4A4A4A">────────────────<BR ALIGN="LEFT"/>session IDs (40)<BR ALIGN="LEFT"/>sub-relações ativas com pesos<BR ALIGN="LEFT"/>discriminador do cluster<BR ALIGN="LEFT"/>endpoint alvo, métricas agregadas<BR ALIGN="LEFT"/>janela W = 300 s<BR ALIGN="LEFT"/>export: JSON-LD + STIX 2.1</FONT>>,
        shape=box,
        style="filled,rounded",
        fillcolor="#F5F5F5",
        color="#6B6B6B",
        penwidth=1
    ];

    // ----- Mitigação com escopo derivado (azul escuro fill sutil) -----
    mitigation [
        label=<<B>Mitigation (Challenge)</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#4A4A4A">────────────────<BR ALIGN="LEFT"/>scope = mínimo discriminador:<BR ALIGN="LEFT"/>(tls_ja4, endpoint_pattern,<BR ALIGN="LEFT"/>temporal_signature)<BR ALIGN="LEFT"/>duração: 30 min após sinal cair</FONT>>,
        shape=box,
        style="filled,rounded",
        fillcolor="#DDE5EE",
        color="#1F3A5F",
        penwidth=1.2
    ];

    // ----- Conexões -----
    cluster_node -> rule [label="entrada"];
    endpoint -> rule [label="entrada"];
    rule -> verdict [label="dispara", penwidth=1.8, color="#1F3A5F", fontcolor="#1F3A5F"];
    verdict -> evidence [label="gera"];
    verdict -> mitigation [label="mitigatedBy", color="#1F3A5F"];
}
