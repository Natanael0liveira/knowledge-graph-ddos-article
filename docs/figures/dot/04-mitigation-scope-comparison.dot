// Diagrama 4 — Posicionamento da contribuição em 9 dimensões × 4 abordagens.
// Revisado com vocabulário operacional de cibersegurança/proteção DDoS:
//   - Separação clara entre "acoplamento" e "granularidade" da mitigação
//   - "Saída do detector" em vez de "Explicabilidade" (mais operacional)
//   - "Captura de coordenação inter-origem" em vez de "Raciocínio cross-session"
//   - "Adaptabilidade a novas variantes" como dimensão operacional
//   - "Validação em Slowloris" removida (era específica demais; entra na prosa)

digraph MitigationScopeComparison {
    rankdir=LR;
    bgcolor="white";
    fontname="Helvetica";
    margin=0;

    node [shape=plaintext, fontname="Helvetica", fontcolor="#1A1A1A"];

    cmp [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#6B6B6B" BGCOLOR="white">
            <!-- Cabeçalho (azul escuro) -->
            <TR>
                <TD BGCOLOR="#1F3A5F" ALIGN="LEFT"><FONT COLOR="white"><B>Dimensão</B></FONT></TD>
                <TD BGCOLOR="#1F3A5F" ALIGN="CENTER"><FONT COLOR="white"><B>ML sobre features<BR/>agregadas</B><BR/><FONT POINT-SIZE="9">Fernandes 2015,<BR/>Bharathi 2012,<BR/>Kemp 2023</FONT></FONT></TD>
                <TD BGCOLOR="#1F3A5F" ALIGN="CENTER"><FONT COLOR="white"><B>KG + neural<BR/>+ XAI pós-hoc</B><BR/><FONT POINT-SIZE="9">KLAGE<BR/>(Belcastro et al.,<BR/>FGCS 2026)</FONT></FONT></TD>
                <TD BGCOLOR="#1F3A5F" ALIGN="CENTER"><FONT COLOR="white"><B>Indústria<BR/>proprietária</B><BR/><FONT POINT-SIZE="9">Cloudflare, Akamai,<BR/>DataDome</FONT></FONT></TD>
                <TD BGCOLOR="#DDE5EE" ALIGN="CENTER"><FONT COLOR="#1F3A5F"><B>Nossa proposta</B><BR/><FONT POINT-SIZE="9">OWL + SWRL/SPARQL,<BR/>família relatedBy ponderada</FONT></FONT></TD>
            </TR>

            <!-- 1. Unidade de raciocínio -->
            <TR>
                <TD ALIGN="LEFT" BGCOLOR="#F5F5F5"><B>Unidade de raciocínio</B></TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Sessão como vetor<BR/>de features agregadas</TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Nó de rede<BR/>(porta, IP, fluxo)</TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Cliente multi-sinal<BR/>(fingerprint, device,<BR/>sessão, IP)</TD>
                <TD ALIGN="LEFT" BGCOLOR="#DDE5EE"><FONT COLOR="#1F3A5F"><B>Sessão HTTP como<BR/>entidade ontológica<BR/>de primeira classe</B></FONT></TD>
            </TR>

            <!-- 2. Representação semântica -->
            <TR>
                <TD ALIGN="LEFT" BGCOLOR="#F5F5F5"><B>Representação semântica</B></TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Vetor numérico,<BR/>sem semântica</TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Embeddings aprendidos<BR/>(Graph-BERT)</TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Sinais combinados<BR/>em score 0–100</TD>
                <TD ALIGN="LEFT" BGCOLOR="#DDE5EE"><FONT COLOR="#1F3A5F"><B>OWL 2 DL + SWRL/SPARQL<BR/>(simbólico nativo)</B></FONT></TD>
            </TR>

            <!-- 3. Captura de coordenação inter-origem -->
            <TR>
                <TD ALIGN="LEFT" BGCOLOR="#F5F5F5"><B>Captura de coordenação<BR/>inter-origem</B></TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Sessões classificadas<BR/>isoladamente</TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Implícita nos<BR/>embeddings, sem<BR/>relação nomeada</TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Em produção via<BR/>device fingerprint<BR/>(método proprietário)</TD>
                <TD ALIGN="LEFT" BGCOLOR="#DDE5EE"><FONT COLOR="#1F3A5F"><B>Família relatedBy_*<BR/>com 6 sub-propriedades<BR/>ponderadas e tipadas</B></FONT></TD>
            </TR>

            <!-- 4. Saída do detector -->
            <TR>
                <TD ALIGN="LEFT" BGCOLOR="#F5F5F5"><B>Saída do detector</B></TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Rótulo binário<BR/>(benigno / ataque)</TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Rótulo + relatório<BR/>textual via LLM<BR/>(LIME post-hoc)</TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Bot Score 0–100<BR/>(caixa preta)</TD>
                <TD ALIGN="LEFT" BGCOLOR="#DDE5EE"><FONT COLOR="#1F3A5F"><B>Veredicto + cadeia<BR/>de evidência simbólica<BR/>(JSON-LD + STIX 2.1)</B></FONT></TD>
            </TR>

            <!-- 5. Acoplamento detecção → mitigação -->
            <TR>
                <TD ALIGN="LEFT" BGCOLOR="#F5F5F5"><B>Acoplamento<BR/>detecção → mitigação</B></TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Desacoplado<BR/>(mitigação externa)</TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Não tratado<BR/>(pipeline termina<BR/>no relatório)</TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Acoplado<BR/>(automático, mas<BR/>proprietário e opaco)</TD>
                <TD ALIGN="LEFT" BGCOLOR="#DDE5EE"><FONT COLOR="#1F3A5F"><B>Acoplado, com<BR/>derivação simbólica<BR/>auditável</B></FONT></TD>
            </TR>

            <!-- 6. Granularidade do escopo de mitigação -->
            <TR>
                <TD ALIGN="LEFT" BGCOLOR="#F5F5F5"><B>Granularidade do<BR/>escopo de mitigação</B></TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Global na rota,<BR/>ou rate-limit por IP</TD>
                <TD ALIGN="LEFT" BGCOLOR="white">N/A</TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Cirúrgica<BR/>(JA4, padrão de rota,<BR/>device, ASN — opaca)</TD>
                <TD ALIGN="LEFT" BGCOLOR="#DDE5EE"><FONT COLOR="#1F3A5F"><B>Cirúrgica, derivada<BR/>do discriminador do<BR/>cluster (auditável)</B></FONT></TD>
            </TR>

            <!-- 7. Auditabilidade da decisão -->
            <TR>
                <TD ALIGN="LEFT" BGCOLOR="#F5F5F5"><B>Auditabilidade<BR/>da decisão</B></TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Modelo interpretável<BR/>(features), mas sem<BR/>encadeamento semântico</TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Código aberto;<BR/>explicação via LIME<BR/>local, não dedutiva</TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Caixa preta<BR/>(sem ontologia,<BR/>sem replicação)</TD>
                <TD ALIGN="LEFT" BGCOLOR="#DDE5EE"><FONT COLOR="#1F3A5F"><B>Ontologia + regras +<BR/>código abertos;<BR/>cadeia dedutiva</B></FONT></TD>
            </TR>

            <!-- 8. Métrica de dano colateral em legítimos -->
            <TR>
                <TD ALIGN="LEFT" BGCOLOR="#F5F5F5"><B>Métrica de dano<BR/>colateral em legítimos</B></TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Não reportada<BR/>(apenas Acc/F1)</TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Não reportada<BR/>(Acc/F1 + qualitativas LLM)</TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Auto-reportada<BR/>(DataDome &lt; 0,01%,<BR/>sem metodologia<BR/>pública)</TD>
                <TD ALIGN="LEFT" BGCOLOR="#DDE5EE"><FONT COLOR="#1F3A5F"><B>Métrica acadêmica<BR/>proposta (% de<BR/>tráfego legítimo<BR/>afetado pelo escopo)</B></FONT></TD>
            </TR>

            <!-- 9. Adaptabilidade a novas variantes -->
            <TR>
                <TD ALIGN="LEFT" BGCOLOR="#F5F5F5"><B>Adaptabilidade a<BR/>novas variantes</B></TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Re-treino<BR/>com novas features</TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Re-treino do<BR/>Graph-BERT</TD>
                <TD ALIGN="LEFT" BGCOLOR="white">Atualização<BR/>fechada por vendor<BR/>(opaca, intransparente)</TD>
                <TD ALIGN="LEFT" BGCOLOR="#DDE5EE"><FONT COLOR="#1F3A5F"><B>Nova subclasse OWL<BR/>+ regra SPARQL,<BR/>publicáveis e revisáveis</B></FONT></TD>
            </TR>
        </TABLE>
    >];
}
