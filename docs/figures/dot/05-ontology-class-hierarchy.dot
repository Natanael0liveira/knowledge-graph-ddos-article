// Diagrama 5 — Hierarquia de classes e propriedades da ontologia OWL.
// Inclui a família relatedTo expandida em sub-relações com pesos diferenciados.
// Paleta refinada: cinzas + azul escuro pontual.

digraph OntologyClassHierarchy {
    rankdir=LR;
    bgcolor="white";
    fontname="Helvetica";
    nodesep=0.3;
    ranksep=1.0;
    labelloc="t";
    label=<<B>Hierarquia da ontologia OWL</B><BR/><FONT POINT-SIZE="10" COLOR="#4A4A4A">Slow HTTP DDoS distribuído como família de ataque coordenado de referência</FONT>>;

    node [fontname="Helvetica", fontsize=10, shape=box, style="filled,rounded", fontcolor="#1A1A1A"];
    edge [fontname="Helvetica", fontsize=9, color="#6B6B6B", fontcolor="#4A4A4A"];

    // ----- Classe central (azul escuro) -----
    AppSession [
        label=<<B>ApplicationSession</B>>,
        fillcolor="#1F3A5F", fontcolor="white", color="#1F3A5F", penwidth=1.5
    ];

    // ----- Hierarquia de ataque -----
    AppLayerAttack [label=<<B>ApplicationLayerAttack</B>>, fillcolor="#E5E5E5", color="#6B6B6B"];
    SlowHTTPFamily [
        label=<<B>SlowHTTPDDoSFamily</B>>,
        fillcolor="#DDE5EE", color="#1F3A5F", penwidth=1.3
    ];
    CoordHTTPFlood [
        label=<<B>CoordinatedHTTPFlood</B><BR/><FONT POINT-SIZE="8" COLOR="#4A4A4A">variantes rate-based<BR/>(HULK, GoldenEye,<BR/>HTTP/2 Rapid Reset)</FONT>>,
        fillcolor="white", color="#6B6B6B"
    ];
    ConnExhaustion [
        label=<<B>ConnectionExhaustionAttack</B><BR/><FONT POINT-SIZE="8" COLOR="#4A4A4A">variantes connection-holding<BR/>(Slowloris, slow body, slow read)</FONT>>,
        fillcolor="white", color="#6B6B6B"
    ];

    AppLayerAttack -> SlowHTTPFamily [label="subClassOf", style=dotted, arrowhead=empty];
    SlowHTTPFamily -> CoordHTTPFlood [label="subClassOf", style=dotted, arrowhead=empty];
    SlowHTTPFamily -> ConnExhaustion [label="subClassOf", style=dotted, arrowhead=empty];

    // ----- Identity e subclasses -----
    Identity [label=<<B>Identity</B>>, fillcolor="#E5E5E5", color="#6B6B6B"];
    Cookie [label="Cookie", fillcolor="white", color="#888888", fontsize=9];
    Token [label="Token (JWT)", fillcolor="white", color="#888888", fontsize=9];
    TLSFp [
        label=<<B>TLSFingerprint</B><BR/><FONT POINT-SIZE="8" COLOR="#4A4A4A">JA3, JA4</FONT>>,
        fillcolor="white", color="#888888"
    ];

    Identity -> Cookie [label="subClassOf", style=dotted, arrowhead=empty];
    Identity -> Token [label="subClassOf", style=dotted, arrowhead=empty];
    Identity -> TLSFp [label="subClassOf", style=dotted, arrowhead=empty];

    // ----- Endpoint -----
    Endpoint [label=<<B>Endpoint</B>>, fillcolor="#E5E5E5", color="#6B6B6B"];
    APIEp [label="APIEndpoint", fillcolor="white", color="#888888", fontsize=9];
    StaticEp [label="StaticAsset", fillcolor="white", color="#888888", fontsize=9];

    Endpoint -> APIEp [label="subClassOf", style=dotted, arrowhead=empty];
    Endpoint -> StaticEp [label="subClassOf", style=dotted, arrowhead=empty];

    // ----- Behavior -----
    Behavior [label=<<B>Behavior</B>>, fillcolor="#E5E5E5", color="#6B6B6B"];
    UserBeh [label="UserBehavior", fillcolor="white", color="#888888", fontsize=9];
    BotBeh [label="BotBehavior", fillcolor="white", color="#888888", fontsize=9];

    Behavior -> UserBeh [label="subClassOf", style=dotted, arrowhead=empty];
    Behavior -> BotBeh [label="subClassOf", style=dotted, arrowhead=empty];

    // ----- Mitigation -----
    Mitigation [label=<<B>Mitigation</B>>, fillcolor="#E5E5E5", color="#6B6B6B"];
    RateLim [label="RateLimit", fillcolor="white", color="#888888", fontsize=9];
    Challenge [label="Challenge", fillcolor="white", color="#888888", fontsize=9];
    Block [label="Block", fillcolor="white", color="#888888", fontsize=9];

    Mitigation -> RateLim [label="subClassOf", style=dotted, arrowhead=empty];
    Mitigation -> Challenge [label="subClassOf", style=dotted, arrowhead=empty];
    Mitigation -> Block [label="subClassOf", style=dotted, arrowhead=empty];

    // ----- Relações tipadas primárias da ApplicationSession (azul escuro) -----
    AppSession -> Identity   [label=<<B>hasIdentity</B>>,        color="#1F3A5F", fontcolor="#1F3A5F", penwidth=1.3];
    AppSession -> Endpoint   [label=<<B>targets</B>>,             color="#1F3A5F", fontcolor="#1F3A5F", penwidth=1.3];
    AppSession -> Behavior   [label=<<B>exhibitsBehavior</B>>,    color="#1F3A5F", fontcolor="#1F3A5F", penwidth=1.3];
    AppSession -> Mitigation [label=<<B>mitigatedBy</B>>,         color="#1F3A5F", fontcolor="#1F3A5F", penwidth=1.3];

    // ----- Família relatedTo (cluster destacado) -----
    subgraph cluster_relatedTo {
        label=<<B>relatedTo</B>  (família de sub-relações ponderadas)>;
        labelloc="t";
        labeljust="l";
        fontsize=10;
        fontcolor="#1F3A5F";
        style="filled,rounded";
        fillcolor="#DDE5EE";
        color="#1F3A5F";
        penwidth=1.2;

        rt_root [
            label=<<B>relatedTo</B><BR/><FONT POINT-SIZE="8" COLOR="#4A4A4A">propriedade base</FONT>>,
            fillcolor="white", color="#1F3A5F", penwidth=1.2
        ];

        rt_tls [label=<<B>relatedByTLSFingerprint</B><BR/><FONT POINT-SIZE="8" COLOR="#4A4A4A">peso: alto</FONT>>, fillcolor="white", color="#888888", fontsize=9];
        rt_id  [label=<<B>relatedByReusedIdentity</B><BR/><FONT POINT-SIZE="8" COLOR="#4A4A4A">peso: alto</FONT>>, fillcolor="white", color="#888888", fontsize=9];
        rt_tmp [label=<<B>relatedByTemporalPattern</B><BR/><FONT POINT-SIZE="8" COLOR="#4A4A4A">peso: alto</FONT>>, fillcolor="white", color="#888888", fontsize=9];
        rt_pl  [label=<<B>relatedByPayloadSignature</B><BR/><FONT POINT-SIZE="8" COLOR="#4A4A4A">peso: médio</FONT>>, fillcolor="white", color="#888888", fontsize=9];
        rt_ec  [label=<<B>relatedByEndpointConvergence</B><BR/><FONT POINT-SIZE="8" COLOR="#4A4A4A">peso: médio</FONT>>, fillcolor="white", color="#888888", fontsize=9];
        rt_net [label=<<B>relatedByNetworkProximity</B><BR/><FONT POINT-SIZE="8" COLOR="#4A4A4A">peso: baixo</FONT>>, fillcolor="white", color="#888888", fontsize=9];

        rt_root -> rt_tls [label="subPropertyOf", style=dotted, fontsize=8];
        rt_root -> rt_id  [label="subPropertyOf", style=dotted, fontsize=8];
        rt_root -> rt_tmp [label="subPropertyOf", style=dotted, fontsize=8];
        rt_root -> rt_pl  [label="subPropertyOf", style=dotted, fontsize=8];
        rt_root -> rt_ec  [label="subPropertyOf", style=dotted, fontsize=8];
        rt_root -> rt_net [label="subPropertyOf", style=dotted, fontsize=8];
    }

    AppSession -> rt_root [
        label=<<B>relatedTo</B>>,
        color="#1F3A5F", fontcolor="#1F3A5F", penwidth=1.3, style=dashed
    ];

    // Ataque alvejando endpoint
    AppLayerAttack -> Endpoint [label=<<B>targets</B>>, color="#1F3A5F", fontcolor="#1F3A5F", penwidth=1.3];

    // Propriedade compartilhada
    propnote [
        shape=note,
        label=<<FONT POINT-SIZE="9"><B>SlowHTTPDDoSFamily</B><BR/>tem propriedade comum:<BR/><B>exhibitsCrossSessionStructure</B></FONT>>,
        fillcolor="#F5F5F5", color="#6B6B6B", style=filled, fontcolor="#1A1A1A"
    ];
    SlowHTTPFamily -> propnote [style=dotted, arrowhead=none];
}
