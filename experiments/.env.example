# Copy to experiments/.env and adjust the paths. Do NOT commit the real .env.
# scripts/setup-data-storage.sh usually writes it, with DATA_ROOT only; these are
# the variables the Makefiles expect.

# Data root (raw/, processed/, synth/, kg/exports/, results/, logs/). It can be an
# external drive: large files and sequential access work well on exFAT.
DATA_ROOT=/Volumes/YourDrive/kg-ddos-data

# Fuseki's TDB2 store (sprint-1 fuseki-up, load-kg-bulk, coordination). It MUST live
# on the internal SSD (APFS): exFAT breaks TDB2's memory mapping (each chunk commit
# thrashes). The store is derived and can be rebuilt, so it need not sit with the
# data. docker-compose.yml mounts ${FUSEKI_DB}:/fuseki.
FUSEKI_DB=/Users/YOUR_USER/kg-ddos-fuseki
