# LEGACY (Sprint 1, gate G4). The NOMS paper prints no query: its Listing 1 is the
# evidence chain. This query reads the kg:DetectionCluster nodes that
# scripts/compute_coordination.py materializes (that vocabulary is not declared in
# ontology/ddos_ontology.owl), with the CIC-IoT2023 thresholds hard-coded. The
# evaluation reads a count query compiled from the ontology
# (experiments/sprint-6-noms/scripts/compile_counts.py), and the SPARQL aggregation
# the cost model times is in experiments/sprint-6-noms/scripts/bench_latency.py.
#
# Gate G4: coordinatedHTTPFlood (Sprint 1)
#
# Returns detection clusters (label-agnostic, grouped by endpoint and window) whose
# coordination score Omega(S) crosses the threshold, with a minimum size and
# aggregate rate. Omega(S) is precomputed by scripts/compute_coordination.py and
# materialized as kg:DetectionCluster / kg:coordinationScore with tdb2.tdbloader
# (make coordination).
#
# The parameters below (tau_cluster = 85.5, k_min = 5, tau_rate = 1.0) are those of
# cic-iot-2023; tau_cluster is the 99th percentile of Omega over the clusters that
# benign traffic dominates. G4 passes if the query returns at least one row.
#
# Usage (the admin password is the one in docker-compose.yml; set your own first):
#   curl -s -u admin:kgddos -H "Accept: text/csv" \
#     --data-urlencode query@queries/coordinatedHTTPFlood.rq \
#     http://localhost:3030/cic-iot-2023/sparql

PREFIX kg: <http://security.example.org/ontology/ddos#>

SELECT ?endpoint ?omega ?size ?rate WHERE {
  ?c a kg:DetectionCluster ;
     kg:coordinationScore ?omega ;
     kg:clusterSize        ?size ;
     kg:aggregateRate      ?rate ;
     kg:targetEndpoint     ?endpoint .
  FILTER(?omega >= 85.5 && ?size >= 5 && ?rate >= 1.0)
}
ORDER BY DESC(?omega)
